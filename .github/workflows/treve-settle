name: Treve - regler les matchs

# Aucun credit consomme tant qu'aucun match publie n'est termine.

on:
  schedule:
    - cron: "12 */4 * * *"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: picks-write
  cancel-in-progress: false

jobs:
  settle:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
      - run: node scripts/cli.mjs trevesettle
        env:
          ODDS_API_KEY: ${{ secrets.ODDS_API_KEY }}
      - name: Commiter
        run: |
          git config user.name "cote-a-cote"
          git config user.email "actions@github.com"
          git add data/picks.json
          git diff --staged --quiet || git commit -m "Treve : matchs regles"
          git push
